+struct FstWalk {
+  std::vector<std::pair<std::string, uint32_t>> dirs;  // path, end index
+  std::string prefix;
+  NodHandle* partition;
+  std::map<std::string, std::pair<std::string, size_t>>* byPath;
+  std::map<std::string, std::pair<NodHandle*, uint32_t>>* discFiles;
+};
+
+uint32_t fstWalkCallback(uint32_t index, NodNodeKind kind, const char* name, uint32_t size, void* userData) {
+  auto* w = static_cast<FstWalk*>(userData);
+  while (!w->dirs.empty() && index >= w->dirs.back().second) {
+    w->dirs.pop_back();
+  }
+  const std::string parent = w->dirs.empty() ? std::string() : w->dirs.back().first;
+  if (kind == NOD_NODE_KIND_DIRECTORY) {
+    w->dirs.emplace_back(index == 0 ? std::string() : parent + "/" + name, size);
+  } else {
+    std::string path = parent + "/" + name;
+    if (path.compare(0, w->prefix.size(), w->prefix) == 0) {
+      (*w->byPath)[path] = {std::string(), size};
+      (*w->discFiles)[path] = {w->partition, index};
+    }
+  }
+  return index + 1;
+}
