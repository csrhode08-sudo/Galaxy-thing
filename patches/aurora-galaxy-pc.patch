+static bool registerOverlayDirectory(const char* root) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (root != nullptr) {
+    if (!fs::is_directory(root, ec)) {
+      return false;
+    }
+    s_overlayRoots.emplace_back(root);
+  }
+
+  static const AuroraOverlayCallbacks callbacks{
+      .open = dirOpen,
+      .close = dirClose,
+      .read = dirRead,
+      .seek = dirSeek,
