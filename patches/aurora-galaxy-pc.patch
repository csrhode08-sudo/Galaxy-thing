+  std::map<std::string, std::pair<NodHandle*, uint32_t>> discFiles;  // disc path -> (overlay disc, FST index)
+  for (const auto& d : s_overlayDiscs) {
+    FstWalk walk{.prefix = d.prefix, .partition = d.partition, .byPath = &byPath, .discFiles = &discFiles};
+    nod_partition_iterate_fst(d.partition, fstWalkCallback, &walk);
+  }
+  for (const auto& r : s_overlayRoots) {
+    const fs::path base(r);
+    for (auto it = fs::recursive_directory_iterator(base, ec); it != fs::recursive_directory_iterator(); it.increment(ec)) {
