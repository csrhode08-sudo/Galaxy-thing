+bool aurora_dvd_open_directory(const char* root, const char* gameId) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (root == nullptr || !fs::is_directory(root, ec)) {
+    return false;
+  }
+
+  s_worker.stop();
+  clearState();
+  s_directoryMode = true;
+  s_overlayRoots.clear();
+
+  if (gameId != nullptr) {
+    std::memcpy(s_diskID.gameName, gameId, std::min<size_t>(4, std::strlen(gameId)));
+    if (std::strlen(gameId) >= 6) {
+      std::memcpy(s_diskID.company, gameId + 4, 2);
+    }
+    std::memcpy(aurora::g_gameName, s_diskID.gameName, sizeof(s_diskID.gameName));
+  }
+
+  registerOverlayDirectory(root);
+
+  s_currentDir = 0;
+  s_currentPath = "/";
+  s_initialized = true;
+  s_worker.start();
+  return true;
+}
+
+bool aurora_dvd_overlay_directory(const char* root) {
+  if (!s_initialized) {
+    return false;
+  }
+  s_worker.stop();
+  const bool ok = registerOverlayDirectory(root);
+  s_worker.start();
+  return ok;
+}
+
+bool aurora_dvd_overlay_disc(const char* discPath, const char* requiredGameId, const char* pathPrefix,
+                             const char* fallbackPrefix) {
+  if (!s_initialized || discPath == nullptr) {
+    return false;
+  }
+  NodHandle* disc = nullptr;
+  const NodDiscOptions options{.preloader_threads = 0};
+  if (nod_disc_open(discPath, &options, &disc) != NOD_RESULT_OK || disc == nullptr) {
+    return false;
+  }
+  NodDiscHeader header{};
+  if (requiredGameId != nullptr &&
+      (nod_disc_header(disc, &header) != NOD_RESULT_OK ||
+       std::strncmp(header.game_id, requiredGameId, std::min<size_t>(6, std::strlen(requiredGameId))) != 0)) {
+    nod_free(disc);
+    return false;
+  }
+  NodHandle* partition = nullptr;
+  if (nod_disc_open_partition_kind(disc, NOD_PARTITION_KIND_DATA, nullptr, &partition) != NOD_RESULT_OK ||
+      partition == nullptr) {
+    nod_free(disc);
+    return false;
+  }
+  s_worker.stop();
+  s_overlayDiscs.push_back({.disc = disc,
+                            .partition = partition,
+                            .prefix = pathPrefix != nullptr ? pathPrefix : "",
+                            .fallbackPrefix = fallbackPrefix != nullptr ? fallbackPrefix : ""});
+  const bool ok = registerOverlayDirectory(nullptr);
+  s_worker.start();
+  return ok;
+}
