+namespace aurora::texture {
+std::string dump_texture_png(const GXTexObj* obj_, const GXTlutObj* tlut_, const std::filesystem::path& dir) {
+  const auto& obj = *reinterpret_cast<const GXTexObj_*>(obj_);
+  const auto* tlut = reinterpret_cast<const GXTlutObj_*>(tlut_);
+  if (!obj.has_data() || obj.width() == 0 || obj.height() == 0) {
+    return {};
+  }
+  const bool palette = gx::is_palette_format(obj.format());
+  if (palette && (tlut == nullptr || tlut->data == nullptr)) {
+    return {};
+  }
+  const auto keys = gx::hash_texture_source(obj, palette ? tlut : nullptr, true);
+  if (!keys.sourceKey.has_value()) {
+    return {};
+  }
+  std::string name = gfx::texture_replacement::build_texture_replacement_name(*keys.sourceKey);
+  if (const auto dot = name.rfind('.'); dot != std::string::npos) {
+    name = name.substr(0, dot) + ".png";
+  }
+  const ArrayRef texData{static_cast<const uint8_t*>(obj.data), UINT32_MAX};
+  gfx::ConvertedTexture pixels;
+  if (palette) {
+    const size_t tlutBytes = gx::texture::tlut_source_size(tlut->numEntries);
+    pixels = gfx::convert_texture_palette(obj.format(), obj.width(), obj.height(), 1, texData, tlut->format,
+                                          tlut->numEntries, {static_cast<const uint8_t*>(tlut->data), tlutBytes});
+  } else {
+    pixels = gfx::convert_texture(obj.format(), obj.width(), obj.height(), 1, texData);
+  }
+  const size_t rgbaBytes = static_cast<size_t>(obj.width()) * obj.height() * 4;
+  if (pixels.data.empty() || pixels.format != wgpu::TextureFormat::RGBA8Unorm || pixels.data.size() < rgbaBytes) {
+    return {};
+  }
+  if (!gfx::png::write_rgba8_png(dir / name, obj.width(), obj.height(), {pixels.data.data(), rgbaBytes})) {
+    return {};
+  }
+  return name;
+}
