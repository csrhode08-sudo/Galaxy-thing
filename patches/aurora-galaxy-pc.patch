+        continue;
+      }
+      std::string rel = "/" + fs::relative(it->path(), base, ec).generic_string();
+      byPath[rel] = {it->path().string(), static_cast<size_t>(it->file_size(ec))};
+      discFiles.erase(rel);  // loose files override files from overlay discs
+    }
+  }
+
+  // Files the overlay disc lacks come from the main disc's equivalent folder.
+  for (const auto& d : s_overlayDiscs) {
+    if (d.fallbackPrefix.empty()) {
+      continue;
+    }
+    std::map<std::string, std::pair<std::string, size_t>> mainPaths;
+    std::map<std::string, std::pair<NodHandle*, uint32_t>> mainFiles;
+    if (s_partition != nullptr) {
+      FstWalk walk{.prefix = d.fallbackPrefix, .partition = s_partition, .byPath = &mainPaths, .discFiles = &mainFiles};
+      nod_partition_iterate_fst(s_partition, fstWalkCallback, &walk);
+    }
+    for (const auto& [path, v] : byPath) {
+      if (path.compare(0, d.fallbackPrefix.size(), d.fallbackPrefix) == 0 && !mainPaths.contains(path)) {
+        mainPaths[path] = v;
+        if (const auto it = discFiles.find(path); it != discFiles.end()) {
+          mainFiles[path] = it->second;
+        }
+      }
+    }
+    for (const auto& [path, v] : mainPaths) {
+      const std::string alias = d.prefix + path.substr(d.fallbackPrefix.size());
+      if (byPath.contains(alias)) {
+        continue;
+      }
+      byPath[alias] = v;
+      if (const auto it = mainFiles.find(path); it != mainFiles.end()) {
+        discFiles[alias] = it->second;
+      }
+    }
+  }
+
+  s_dirFiles.clear();
+  std::vector<AuroraOverlayFile> files;
+  files.reserve(byPath.size());
+  for (const auto& [rel, host] : byPath) {
+    auto file = std::make_unique<DirFile>();
+    file->path = host.first;
+    if (const auto it = discFiles.find(rel); it != discFiles.end()) {
+      file->partition = it->second.first;
+      file->fstIndex = it->second.second;
+    }
+    files.push_back(AuroraOverlayFile{rel.c_str(), file.get(), host.second});
+    s_dirFiles.push_back(std::move(file));
+  }
+  aurora_dvd_overlay_files(files.data(), files.size(), nullptr);
+  return true;
+}
