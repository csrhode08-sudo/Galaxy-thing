+// Directory-backed "disc": every file below `root` is served as an overlay file. Used for extracted game files.
+namespace {
+struct DirFile {
+  std::string path;
+};
+
+void* dirOpen(void* userData) {
+  auto* file = static_cast<DirFile*>(userData);
+  return SDL_IOFromFile(file->path.c_str(), "rb");
+}
+
+void dirClose(void* handle) { SDL_CloseIO(static_cast<SDL_IOStream*>(handle)); }
+
+int64_t dirRead(void* handle, uint8_t* buf, size_t len) {
+  auto* io = static_cast<SDL_IOStream*>(handle);
+  size_t total = 0;
+  while (total < len) {
+    const size_t n = SDL_ReadIO(io, buf + total, len - total);
+    if (n == 0) {
+      break;
+    }
+    total += n;
+  }
+  return static_cast<int64_t>(total);
+}
+
+int64_t dirSeek(void* handle, int64_t offset, int32_t whence) {
+  const SDL_IOWhence w = whence == 1 ? SDL_IO_SEEK_CUR : whence == 2 ? SDL_IO_SEEK_END : SDL_IO_SEEK_SET;
+  return SDL_SeekIO(static_cast<SDL_IOStream*>(handle), offset, w);
+}
+
+std::vector<std::unique_ptr<DirFile>> s_dirFiles;
+}  // namespace
+
+// Directories whose files are served as overlay files; later directories override earlier ones.
+static std::vector<std::string> s_overlayRoots;
+
+static bool registerOverlayDirectory(const char* root) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (root == nullptr || !fs::is_directory(root, ec)) {
+    return false;
+  }
+  s_overlayRoots.emplace_back(root);
+
+  static const AuroraOverlayCallbacks callbacks{
+      .open = dirOpen,
+      .close = dirClose,
+      .read = dirRead,
+      .seek = dirSeek,
+  };
+  aurora_dvd_overlay_callbacks(&callbacks);
+
+  std::map<std::string, std::pair<std::string, size_t>> byPath;  // disc path -> (host path, size)
+  for (const auto& r : s_overlayRoots) {
+    const fs::path base(r);
+    for (auto it = fs::recursive_directory_iterator(base, ec); it != fs::recursive_directory_iterator(); it.increment(ec)) {
+      if (ec || !it->is_regular_file(ec)) {
+        continue;
+      }
+      std::string rel = "/" + fs::relative(it->path(), base, ec).generic_string();
+      byPath[rel] = {it->path().string(), static_cast<size_t>(it->file_size(ec))};
+    }
+  }
+
+  s_dirFiles.clear();
+  std::vector<AuroraOverlayFile> files;
+  files.reserve(byPath.size());
+  for (const auto& [rel, host] : byPath) {
+    auto file = std::make_unique<DirFile>();
+    file->path = host.first;
+    files.push_back(AuroraOverlayFile{rel.c_str(), file.get(), host.second});
+    s_dirFiles.push_back(std::move(file));
+  }
+  aurora_dvd_overlay_files(files.data(), files.size(), nullptr);
+  return true;
+}
+
+bool aurora_dvd_open_directory(const char* root, const char* gameId) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (root == nullptr || !fs::is_directory(root, ec)) {
+    return false;
+  }
+
+  s_worker.stop();
+  clearState();
+  s_directoryMode = true;
+  s_overlayRoots.clear();
+
+  if (gameId != nullptr) {
+    std::memcpy(s_diskID.gameName, gameId, std::min<size_t>(4, std::strlen(gameId)));
+    if (std::strlen(gameId) >= 6) {
+      std::memcpy(s_diskID.company, gameId + 4, 2);
+    }
+    std::memcpy(aurora::g_gameName, s_diskID.gameName, sizeof(s_diskID.gameName));
+  }
+
+  registerOverlayDirectory(root);
+
+  s_currentDir = 0;
+  s_currentPath = "/";
+  s_initialized = true;
+  s_worker.start();
+  return true;
+}
+
+bool aurora_dvd_overlay_directory(const char* root) {
+  if (!s_initialized) {
+    return false;
+  }
+  s_worker.stop();
+  const bool ok = registerOverlayDirectory(root);
+  s_worker.start();
+  return ok;
+}
+
 void aurora_dvd_close(void) {
