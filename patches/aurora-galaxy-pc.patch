+// Directory-backed "disc": every file below `root` is served as an overlay file. Used for extracted game files.
+namespace {
+// An overlay file is either a host file or a file inside a second disc image (see aurora_dvd_overlay_disc).
+struct DirFile {
+  std::string path;
+  NodHandle* partition = nullptr;
+  uint32_t fstIndex = 0;
+};
+
+struct OverlayHandle {
+  SDL_IOStream* io = nullptr;
+  NodHandle* nod = nullptr;
+};
+
+void* dirOpen(void* userData) {
+  auto* file = static_cast<DirFile*>(userData);
+  if (file->partition != nullptr) {
+    NodHandle* handle = nullptr;
+    if (nod_partition_open_file(file->partition, file->fstIndex, &handle) != NOD_RESULT_OK || handle == nullptr) {
+      return nullptr;
+    }
+    return new OverlayHandle{.nod = handle};
+  }
+  SDL_IOStream* io = SDL_IOFromFile(file->path.c_str(), "rb");
+  return io != nullptr ? new OverlayHandle{.io = io} : nullptr;
+}
+
+void dirClose(void* handle) {
+  auto* h = static_cast<OverlayHandle*>(handle);
+  if (h->io != nullptr) {
+    SDL_CloseIO(h->io);
+  }
+  if (h->nod != nullptr) {
+    nod_free(h->nod);
+  }
+  delete h;
+}
+
+int64_t dirRead(void* handle, uint8_t* buf, size_t len) {
+  auto* h = static_cast<OverlayHandle*>(handle);
+  size_t total = 0;
+  while (total < len) {
+    int64_t n;
+    if (h->nod != nullptr) {
+      n = nod_read(h->nod, buf + total, len - total);
+      if (n < 0) {
+        return total != 0 ? static_cast<int64_t>(total) : -1;
+      }
+    } else {
+      n = static_cast<int64_t>(SDL_ReadIO(h->io, buf + total, len - total));
+    }
+    if (n == 0) {
+      break;
+    }
+    total += static_cast<size_t>(n);
+  }
+  return static_cast<int64_t>(total);
+}
+
+int64_t dirSeek(void* handle, int64_t offset, int32_t whence) {
+  auto* h = static_cast<OverlayHandle*>(handle);
+  if (h->nod != nullptr) {
+    return nod_seek(h->nod, offset, whence);
+  }
+  const SDL_IOWhence w = whence == 1 ? SDL_IO_SEEK_CUR : whence == 2 ? SDL_IO_SEEK_END : SDL_IO_SEEK_SET;
+  return SDL_SeekIO(h->io, offset, w);
+}
