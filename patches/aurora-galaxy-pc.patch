+// Open-file handles live in a side table keyed by the command block, not in DVDCommandBlock::userData:
+// games use userData for their own callbacks (Super Mario Galaxy's movie player stores `this` there).
+std::mutex s_handleMutex;
+std::unordered_map<const DVDCommandBlock*, CommandDataBase*> s_handles;
+
+void setFileHandle(const DVDCommandBlock* block, CommandDataBase* handle) {
+  std::lock_guard lock(s_handleMutex);
+  s_handles[block] = handle;
+}
+
+CommandDataBase* findFileHandle(const DVDCommandBlock* block) {
+  std::lock_guard lock(s_handleMutex);
+  const auto it = s_handles.find(block);
+  return it != s_handles.end() ? it->second : nullptr;
+}
+
+CommandDataBase* takeFileHandle(const DVDCommandBlock* block) {
+  std::lock_guard lock(s_handleMutex);
+  const auto it = s_handles.find(block);
+  if (it == s_handles.end()) {
+    return nullptr;
+  }
+  CommandDataBase* handle = it->second;
+  s_handles.erase(it);
+  return handle;
+}
